+static PyObject *model_pair_clearances(ModelObject *self,PyObject *obj) {
+    so101_real deg[SO101_NJ]; if (!read_deg(obj,deg)) return NULL;
+    PyObject *result=PyDict_New();
+    for (int code=1;code<=so101_pair_count();code++) {
+        float low=0,high=(float)self->m.gap;
+        if (!so101_pair_collides(&self->m,deg,high,code)) low=high;
+        else while (nextafterf(low,high)<high) {
+            float middle=(low+high)/2;
+            if (middle==low || middle==high) break;
+            if (so101_pair_collides(&self->m,deg,middle,code)) high=middle; else low=middle;
+        }
+        PyObject *value=PyFloat_FromDouble(low);
+        PyDict_SetItemString(result,so101_collision_name(code),value); Py_DECREF(value);
+    }
+    return result;
+}
+static PyObject *model_pair_collisions(ModelObject *self,PyObject *args) {
+    PyObject *obj,*overrides=Py_None;
+    if (!PyArg_ParseTuple(args,"O|O",&obj,&overrides)) return NULL;
+    if (overrides!=Py_None && !PyDict_Check(overrides)) { PyErr_SetString(PyExc_TypeError,"pair gaps must be a dictionary"); return NULL; }
+    so101_real deg[SO101_NJ]; if (!read_deg(obj,deg)) return NULL;
+    PyObject *result=PyList_New(0);
+    for (int code=1;code<=so101_pair_count();code++) {
+        const char *name=so101_collision_name(code);
+        PyObject *item=overrides==Py_None?NULL:PyDict_GetItemString(overrides,name);
+        double gap=item?PyFloat_AsDouble(item):self->m.gap;
+        if (PyErr_Occurred() || !isfinite(gap) || gap<0 || gap>self->m.gap) { Py_DECREF(result); if (!PyErr_Occurred()) PyErr_SetString(PyExc_ValueError,"pair gap outside native bounds"); return NULL; }
+        if (so101_pair_collides(&self->m,deg,gap,code)) {
+            PyObject *label=PyUnicode_FromString(name); PyList_Append(result,label); Py_DECREF(label);
+        }
+    }
+    return result;
