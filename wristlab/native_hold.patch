+/* Metadata/read-only configuration: no servo goal, torque or RAM writes. */
+static PyObject *arm_supported_stop(ArmObject *self,PyObject *value) {
+    OPEN(self);TAKE(self);
+    if (value==Py_None) {
+        self->supported_stop=self->encoder_stop_requested=self->encoder_stop_pending=0;
+        GIVE(self);Py_RETURN_NONE;
+    }
+    so101_real offset[SO101_NJ];
+    if (!read_deg(value,offset)) {GIVE(self);return NULL;}
+    for (int j=0;j<SO101_NJ;j++) {
+        so101_real scale=j==SO101_GRIP?self->arm.model.gripper_span_deg/100:1;
+        if (!isfinite(offset[j]) || fabs(offset[j]*scale)>self->arm.start_max) {
+            GIVE(self);PyErr_SetString(PyExc_ValueError,"hold reference exceeds native start bound");return NULL;
+        }
+    }
+    int goals[SO101_NJ];
+    for (int j=0;j<SO101_NJ;j++) {
+        if (so101_sts_read2(&self->arm.hal,(uint8_t)self->arm.cal[j].id,STS_GOAL_POSITION,&goals[j])) {
+            GIVE(self);PyErr_SetString(Fault,"cannot read existing powered holding goals");return NULL;
+        }
+    }
+    memcpy(self->stop_offset,offset,sizeof offset);memcpy(self->supported_goals,goals,sizeof goals);
+    self->supported_grip=goals[SO101_GRIP];self->supported_stop=1;
+    GIVE(self);Py_RETURN_NONE;
+}
+static PyObject *arm_encoder_hold(ArmObject *self,PyObject *args) {
+    PyObject *offset,*lower,*upper;
+    so101_real lo[SO101_NJ],hi[SO101_NJ];
+    int raw_lo[SO101_NJ],raw_hi[SO101_NJ];
+    if (!PyArg_ParseTuple(args,"OOO",&offset,&lower,&upper) ||
+        !read_deg(lower,lo) || !read_deg(upper,hi)) return NULL;
+    OPEN(self);
+    for (int j=0;j<SO101_NJ;j++) {
+        if (!isfinite(lo[j]) || !isfinite(hi[j]) || lo[j]>hi[j]) {
+            PyErr_SetString(PyExc_ValueError,"invalid checked encoder hold window");return NULL;
+        }
+        raw_lo[j]=adapter_raw(&self->arm.cal[j],j,lo[j]);
+        raw_hi[j]=adapter_raw(&self->arm.cal[j],j,hi[j]);
+        if (raw_lo[j]<self->arm.cal[j].range_min || raw_hi[j]>self->arm.cal[j].range_max) {
+            PyErr_SetString(PyExc_ValueError,"encoder hold window exceeds calibrated limits");return NULL;
+        }
+    }
+    PyObject *armed=arm_supported_stop(self,offset);
+    if (!armed) return NULL;
+    Py_DECREF(armed);
+    for (int j=0;j<SO101_NJ;j++) {
+        if (self->supported_goals[j]<raw_lo[j] || self->supported_goals[j]>raw_hi[j]) {
+            self->supported_stop=0;
+            PyErr_SetString(PyExc_ValueError,"powered goals are outside the checked encoder hold window");return NULL;
+        }
+    }
+    memcpy(self->encoder_hold_lower,raw_lo,sizeof raw_lo);
+    memcpy(self->encoder_hold_upper,raw_hi,sizeof raw_hi);
+    self->encoder_stop_requested=self->encoder_stop_pending=0;
+    self->supported_stop=2;
+    Py_RETURN_NONE;
+}
+static void goal_packet(ArmObject *o,const int *raw,uint8_t *packet) {
+    packet[0]=packet[1]=255;packet[2]=254;packet[3]=4+3*SO101_NJ;
+    packet[4]=0x83;packet[5]=STS_GOAL_POSITION;packet[6]=2;
+    for (int j=0;j<SO101_NJ;j++) {
+        packet[7+3*j]=(uint8_t)o->arm.cal[j].id;
+        packet[8+3*j]=(uint8_t)(raw[j]&255);packet[9+3*j]=(uint8_t)((raw[j]>>8)&255);
+    }
+    unsigned sum=0;for (int k=2;k<7+3*SO101_NJ;k++) sum+=packet[k];
+    packet[7+3*SO101_NJ]=(uint8_t)~sum;
+}
