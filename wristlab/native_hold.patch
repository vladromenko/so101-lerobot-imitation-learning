+/* Wristlab HAL adapter. The factory follower and freeze() are unchanged.
+ * Only an explicitly armed, empty-tool recovery uses the measured hold reference. */
+static int adapter_raw(const so101_servo_cal *cal,int joint,so101_real angle) {
+    if (joint==SO101_GRIP) {
+        angle=angle<0?0:angle>100?100:angle;
+        return (int)(angle/100*(cal->range_max-cal->range_min)+cal->range_min);
+    }
+    so101_real value=angle*4095/360+(cal->range_min+cal->range_max)/2.0;
+    return (int)(value<0?0:value>4095?4095:value);
+}
+static int supported_raw(ArmObject *o,const so101_real *actual,const so101_real *offset,int *raw) {
+    so101_real reference[SO101_NJ];
+    for (int j=0;j<SO101_NJ;j++) reference[j]=actual[j]+offset[j];
+    so101_pose pose;so101_pose_eval(&o->arm.model,reference,&pose);
+    for (int j=0;j<SO101_NJ;j++) {
+        so101_real goal=reference[j];
+        if (j>=SO101_LIFT && j<=SO101_ROLL) goal+=o->arm.sag*pose.torque[j];
+        raw[j]=adapter_raw(&o->arm.cal[j],j,goal);
+        if (raw[j]<o->arm.cal[j].range_min || raw[j]>o->arm.cal[j].range_max) return 0;
+    }
+    return 1;
+}
+static int supported_packet(ArmObject *o,const uint8_t *input,int n,uint8_t *output) {
+    if (!o->supported_stop || (o->supported_stop==2 && !o->encoder_stop_pending) ||
+        n!=8+3*SO101_NJ || input[0]!=255 || input[1]!=255 ||
+        input[2]!=254 || input[4]!=0x83 || input[5]!=STS_GOAL_POSITION || input[6]!=2) return 0;
+    if (o->supported_stop==2) o->encoder_stop_pending=0;
+    /* Normal send_goals() packets contain compensation. freeze() writes the
+     * freshly read encoder angles directly. Match every ID and raw target. */
+    for (int j=0;j<SO101_NJ;j++) {
+        if (input[7+3*j]!=o->arm.cal[j].id ||
+            so101_sts_u16(input+8+3*j)!=adapter_raw(&o->arm.cal[j],j,o->arm.goal[j])) return 0;
+    }
+    int hold[SO101_NJ];
+    const int *raw=o->supported_goals;
+    if (o->supported_stop==2) {
+        if (!supported_raw(o,o->arm.goal,o->stop_offset,hold)) return 0;
+        hold[SO101_GRIP]=o->supported_grip;
+        for (int j=0;j<SO101_NJ;j++)
+            if (hold[j]<o->encoder_hold_lower[j] || hold[j]>o->encoder_hold_upper[j]) return 0;
+        raw=hold;
+    }
+    memcpy(output,input,n);
+    for (int j=0;j<SO101_NJ;j++) {
+        output[8+3*j]=(uint8_t)(raw[j]&255);
+        output[9+3*j]=(uint8_t)((raw[j]>>8)&255);
+    }
+    unsigned sum=0;for (int k=2;k<n-1;k++) sum+=output[k];
+    output[n-1]=(uint8_t)~sum;
+    return 1;
+}
