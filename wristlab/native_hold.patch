+/* Read-only pair query; ordinary collision checking above is unchanged. */
+int so101_pair_count(void) { return 5+NPAIRS; }
+int so101_pair_collides(const so101_model *m,const so101_real deg[SO101_NJ],so101_real gap_r,int code) {
+    so101_tf F[8]; ftf T[SO101_NL];
+    so101_frames(m,deg,F);
+    (void)so101_collides_frames(m,F,gap_r); /* prepare the native BVH leaf cache */
+    for (int k=0;k<SO101_NL;k++) {
+        for (int i=0;i<9;i++) T[k].R[i]=(float)F[k].R[i];
+        for (int i=0;i<3;i++) T[k].p[i]=(float)F[k].p[i];
+    }
+    if (code>=1 && code<=5) return below(SO101_LINK_ROOT[code+1],&T[code+1],(float)(m->table_z+gap_r));
+    int pair=code-6;
+    if (pair<0 || pair>=NPAIRS) return 1;
+    int A=PAIRS[pair][0],B=PAIRS[pair][1];
+    return near_pair(SO101_LINK_ROOT[A],&T[A],SO101_LINK_ROOT[B],&T[B],(float)gap_r);
+}
