+/* Read-only reconnect: preserve hardware goals, torque and RAM settings. */
+/* Same-owner register reads, including from its tick callback. No writes. */
+static PyObject *arm_read_registers(ArmObject *self, PyObject *args) {
+    int address,n;
+    if (!PyArg_ParseTuple(args,"ii",&address,&n)) return NULL;
+    if (address<0 || n<1 || address+n>256) { PyErr_SetString(PyExc_ValueError,"invalid register span"); return NULL; }
+    OPEN(self); if (!take(self,1)) return NULL;
+    unsigned long was=self->busy; self->busy=PyThread_get_thread_ident();
+    uint8_t ids[SO101_NJ];
+    for (int j=0;j<SO101_NJ;j++) ids[j]=(uint8_t)self->arm.cal[j].id;
+    PyObject *bytes=PyBytes_FromStringAndSize(NULL,SO101_NJ*n);
+    if (!bytes) { self->busy=was; return NULL; }
+    int rc=so101_sts_sync_read(&self->arm.hal,(uint8_t)address,n,ids,SO101_NJ,(uint8_t*)PyBytes_AS_STRING(bytes));
+    self->busy=was;
+    if (rc) { Py_DECREF(bytes); PyErr_SetString(Fault,"servo telemetry read failed"); return NULL; }
+    PyObject *rows=PyTuple_New(SO101_NJ);
+    for (int j=0;j<SO101_NJ;j++) PyTuple_SET_ITEM(rows,j,PyBytes_FromStringAndSize(PyBytes_AS_STRING(bytes)+j*n,n));
+    Py_DECREF(bytes); return rows;
+}
+
+static PyObject *arm_adopt_hold(ArmObject *self, PyObject *noargs) {
+    OPEN(self); TAKE(self);
+    so101_arm *a = &self->arm;
+    int rc=so101_arm_check(a), enabled=0, goals[SO101_NJ];
+    if (rc) return call_done(self,rc);
+    for (int j=0;j<SO101_NJ;j++) {
+        uint8_t on,acceleration; int goal,present,limit;
+        uint8_t id=(uint8_t)a->cal[j].id;
+        if (so101_sts_read(&a->hal,id,STS_TORQUE_ENABLE,&on,1) ||
+            so101_sts_read2(&a->hal,id,STS_GOAL_POSITION,&goal) ||
+            so101_sts_read2(&a->hal,id,STS_PRESENT_POSITION,&present) ||
+            so101_sts_read(&a->hal,id,STS_ACCELERATION,&acceleration,1) ||
+            so101_sts_read2(&a->hal,id,STS_TORQUE_LIMIT,&limit)) {
+            GIVE(self); PyErr_SetString(Fault,"adopt_hold: servo feedback missing"); return NULL;
+        }
+        enabled += on==1; goals[j]=goal;
+        so101_real degrees_per_step = j==SO101_GRIP ? a->model.gripper_span_deg/(a->cal[j].range_max-a->cal[j].range_min) : 360.0/4095.0;
+        if (on && (abs(goal-present)*degrees_per_step>a->lag_max || goal<a->cal[j].range_min || goal>a->cal[j].range_max || acceleration!=a->acceleration || limit>a->torque_limit)) {
+            GIVE(self); PyErr_SetString(Fault,"adopt_hold: existing goal or RAM settings are not admissible"); return NULL;
+        }
+    }
+    if (!enabled) { GIVE(self); Py_RETURN_FALSE; }
+    if (enabled!=SO101_NJ) {
+        GIVE(self); PyErr_SetString(Fault,"adopt_hold: mixed torque state"); return NULL;
+    }
+    so101_real first[SO101_NJ],actual[SO101_NJ];
+    if ((rc=so101_arm_read(a,first,NULL,NULL))) return call_done(self,rc);
+    a->hal.sleep_us(a->hal.ctx,a->tick_us);
+    if ((rc=so101_arm_read(a,actual,NULL,NULL))) return call_done(self,rc);
+    for (int j=0;j<SO101_NJ;j++) {
+        int goal;
+        so101_real resolution = j==SO101_GRIP ? 100.0/(a->cal[j].range_max-a->cal[j].range_min) : 360.0/4095.0;
+        if (so101_sts_read2(&a->hal,(uint8_t)a->cal[j].id,STS_GOAL_POSITION,&goal) ||
+            goal!=goals[j] || fabs(actual[j]-first[j])>resolution+1e-9) {
+            GIVE(self); PyErr_SetString(Fault,"adopt_hold: arm or existing goals are moving"); return NULL;
+        }
+    }
+    memcpy(a->goal,actual,sizeof actual); memcpy(a->start,actual,sizeof actual);
+    memset(a->lead,0,sizeof a->lead);
+    a->have_pose=0; a->have_target=0; a->folded=0; a->torque=1;
+    h_log(self,"adopt_hold: stationary powered servos; all hardware goals preserved");
+    GIVE(self); Py_RETURN_TRUE;
